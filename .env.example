APP_NAME=AccessLens
DATABASE_URL=sqlite+aiosqlite:///./accesslens.db
SCAN_TIMEOUT_SECONDS=45
# Optional overrides (relative paths are relative to the launch directory):
# SCREENSHOT_DIR=app/web/static/screenshots
# AXE_JS_PATH=app/engine/vendor/axe.min.js

# Verify public domains when VPN/proxy DNS returns synthetic IPv4 (198.18/15) or IPv6 (2001:2::/48) addresses,
# or when the system DNS lookup fails. Genuine private targets stay blocked.
DNS_PUBLIC_FALLBACK=true
# HTTPS DNS request timeout per provider/request; accepted range 1-15 seconds.
DNS_HTTPS_TIMEOUT_SECONDS=8

# Chromium follows HTTPS_PROXY / HTTP_PROXY / ALL_PROXY when set (auto).
# With a normal VPN/TUN connection and no proxy environment, it uses system networking.
BROWSER_PROXY_MODE=auto
# Optional override: use the actual local HTTP/SOCKS port shown by your VPN client.
# BROWSER_PROXY_URL=http://127.0.0.1:7890
